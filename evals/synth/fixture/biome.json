{
	"$schema": "https://biomejs.dev/schemas/2.3.5/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": { "noNonNullAssertion": "off" }
		}
	},
	"formatter": { "enabled": true, "indentStyle": "tab", "lineWidth": 120 },
	"files": { "includes": ["src/**/*.ts", "test/**/*.ts", "*.json", "!package-lock.json"] }
}
