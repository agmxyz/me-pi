{
  "name": "me-pi",
  "version": "0.1.6",
  "private": true,
  "description": "My Pi setup: global policy, skills, the pi-workers extensions, and the steps and minimal-footer extensions",
  "license": "MIT",
  "repository": "https://github.com/agmxyz/me-pi",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm test && ./test/install.test.sh && git --no-pager diff --check HEAD",
    "lint": "biome check --error-on-warnings .",
    "fix": "biome check --error-on-warnings --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "pi": {
    "extensions": [
      "extensions/delegate.ts",
      "extensions/guard.ts",
      "extensions/skill.ts",
      "extensions/steps.ts",
      "extensions/minimal-footer.ts"
    ],
    "skills": [],
    "changelogPath": "packages/pi-workers/CHANGELOG.md"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "22.19.19",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
